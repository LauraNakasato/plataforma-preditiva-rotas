# ==============================================================================
# Configurações do Serviço de Alertas de Alagamento (alert_service)
# Copie este arquivo para .env e preencha com suas credenciais:
#   cp .env.example .env
# ==============================================================================

# ----------------- CEMADEN (Plataforma de Entrega de Dados - PED) --------------
# URL base dos webservices do CEMADEN
CEMADEN_URL=https://sws.cemaden.gov.br/PED/rest

# JWT Token de autenticação fornecido pelo webservice /controle-token/tokens
CEMADEN_TOKEN=seu_jwt_token_aqui

# Código IBGE do município monitorado (Padrão: 3547809 para Santo André)
COD_IBGE_MUNICIPIO=3547809


# ----------------- SUPABASE (Banco de Dados das Zonas de Risco) ---------------
# URL do projeto Supabase
SUPABASE_URL=https://dzhfqsftxdkauwgrxgdf.supabase.co

# Chave pública/anon do Supabase
SUPABASE_KEY=sb_publishable_ZBEoCCMdz62UE_6HQEGQPg_93RWIrvR

# Chave privada service_role (OBRIGATÓRIO para permissão de INSERT na tabela zonas_risco)
# Obtenha no painel do Supabase em Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=


# ----------------- PARÂMETROS DO MONITORAMENTO --------------------------------
# Intervalo em minutos entre cada verificação na API do CEMADEN
INTERVALO_MINUTOS=10

# Raio de influência espacial ao redor de cada pluviômetro (em km)
RAIO_INFLUENCIA_KM=3.0

